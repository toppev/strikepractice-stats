# Copy to .env and fill in. Leave DATABASE_URL empty to see the demo data.
#
# MySQL / MariaDB (the plugin's database.type: mysql). Use a read-only user, see docs/DEPLOYING.md.
#   On the same machine as Docker:  mysql://stats:password@host.docker.internal:3306/strikepractice
#   Another host:                   mysql://stats:password@db.example.net:3306/strikepractice
#
# SQLite (database.type: sqlite), with the plugin's sqlite folder mounted at /data:
#   sqlite:///data/database.db
DATABASE_URL=
