# Supply-chain guards (npm 11+; older npm warns about unknown keys and ignores them)

# Only install versions that have been public for a week; most malicious releases are caught and
# pulled within days. A fresh security fix may need a temporary --min-release-age=0.
min-release-age=7
# No dependencies from git repositories: they skip the registry's checks and can change under the same ref.
allow-git=none
# Don't run packages' install scripts (the usual way a compromised package executes on install).
# Nothing here needs them: esbuild's postinstall only verifies its binary.
ignore-scripts=true
# package.json pins exact versions, so updates are always a deliberate change
save-exact=true
